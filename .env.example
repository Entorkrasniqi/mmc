# Copy to .env (which git ignores) and change every password. Never commit real passwords.
#   cp .env.example .env

# superuser of the PostgreSQL container: only for administration, never used by the application
POSTGRES_PASSWORD=change-me-admin

# where the database is (the host side of the port published by docker-compose.yml)
MINISAT_DB_HOST=localhost
MINISAT_DB_PORT=5432
MINISAT_DB_NAME=minisat

# one password per database role (protocols/action-runner-and-audit.md)
MINISAT_DB_PASSWORD_MIGRATOR=change-me-migrator
MINISAT_DB_PASSWORD_RUNNER=change-me-runner
MINISAT_DB_PASSWORD_READER=change-me-reader
MINISAT_DB_PASSWORD_INGEST=change-me-ingest

# the HTTP API (minisat api). DEV ONLY: one static bearer token per operator, no expiry. Make real ones with 'minisat dev-tokens';
# with none set, nobody can log in. Never commit real tokens.
# MINISAT_API_DEV_TOKENS=alice=change-me-at-least-16-characters,sam=change-me-too-at-least-16-chars
# the dashboard origin(s) the browser may call from (default: the Vite dev server on this machine)
# MINISAT_API_CORS_ORIGINS=http://127.0.0.1:5173
# 0 if the stack has no live telemetry source (then /health/ready does not wait for telemetry)
# MINISAT_API_LIVE_SOURCE=1
