# Copy to .env (which git ignores) and change every password. Never commit real passwords.
#   cp .env.example .env

# superuser of the PostgreSQL container: only for administration, never used by the application
POSTGRES_PASSWORD=change-me-admin

# where the database is (the host side of the port published by docker-compose.yml)
MINISAT_DB_HOST=localhost
MINISAT_DB_PORT=5432
MINISAT_DB_NAME=minisat

# one password per database role (protocols/action-runner-and-audit.md)
MINISAT_DB_PASSWORD_MIGRATOR=change-me-migrator
MINISAT_DB_PASSWORD_RUNNER=change-me-runner
MINISAT_DB_PASSWORD_READER=change-me-reader
MINISAT_DB_PASSWORD_INGEST=change-me-ingest
