{
  "name": "@blueprintjs/docs-theme",
  "version": "6.2.7",
  "description": "Blueprint theme for documentalist",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "esnext": "lib/esnext/index.js",
  "typings": "lib/esm/index.d.ts",
  "style": "lib/css/docs-theme.css",
  "files": [
    "lib",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@documentalist/client": "^5.0.0",
    "classnames": "^2.3.1",
    "fuzzaldrin-plus": "^0.6.0",
    "lz-string": "^1.5.0",
    "tslib": "~2.6.2",
    "@blueprintjs/colors": "^5.1.16",
    "@blueprintjs/core": "^6.21.0",
    "@blueprintjs/icons": "^6.14.1",
    "@blueprintjs/select": "^6.4.0"
  },
  "peerDependencies": {
    "@types/react": "18 || 19",
    "react": "18 || 19",
    "react-dom": "18 || 19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/fuzzaldrin-plus": "~0.6.5",
    "npm-run-all": "^4.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.3",
    "webpack-cli": "^5.1.4",
    "@blueprintjs/node-build-scripts": "^10.0.1",
    "@blueprintjs/stylelint-plugin": "^5.2.5"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:palantir/blueprint.git",
    "directory": "packages/docs-theme"
  },
  "keywords": [
    "palantir",
    "blueprint",
    "docs",
    "theme",
    "documentalist"
  ],
  "author": "Palantir Technologies",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf coverage lib",
    "compile": "run-p \"compile:*\"",
    "compile:esm": "tsc -p ./src",
    "compile:cjs": "tsc -p ./src -m commonjs --verbatimModuleSyntax false --outDir lib/cjs",
    "compile:esnext": "tsc -p ./src -t esnext --outDir lib/esnext",
    "compile:css": "sass-compile ./src",
    "dev": "run-p \"compile:esm --watch\" \"compile:css --watch\"",
    "dist": "run-s \"dist:*\"",
    "dist:css": "css-dist lib/css",
    "dist:verify": "assert-package-layout",
    "lint": "run-p lint:scss lint:es",
    "lint:scss": "sass-lint",
    "lint:es": "es-lint",
    "lint-fix": "es-lint --fix && sass-lint --fix",
    "verify": "npm-run-all compile -p dist lint"
  }
}